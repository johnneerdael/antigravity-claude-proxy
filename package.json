{
  "name": "antigravity-gateway",
  "version": "2.1.0",
  "description": "Universal AI gateway - access Claude & Gemini models via OpenAI or Anthropic-compatible API through Antigravity Cloud Code",
  "main": "src/index.js",
  "type": "module",
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "accounts": "node src/cli/accounts.js",
    "accounts:add": "node src/cli/accounts.js add",
    "accounts:list": "node src/cli/accounts.js list",
    "accounts:remove": "node src/cli/accounts.js remove",
    "accounts:verify": "node src/cli/accounts.js verify"
  },
  "keywords": [
    "claude",
    "gemini",
    "anthropic",
    "openai",
    "antigravity",
    "proxy",
    "gateway",
    "ai",
    "llm",
    "cursor",
    "continue",
    "aider",
    "cline",
    "litellm"
  ],
  "author": "Badri Narayanan",
  "contributors": [
    "John Neerdael"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnneerdael/antigravity-gateway.git"
  },
  "homepage": "https://github.com/johnneerdael/antigravity-gateway#readme",
  "bugs": {
    "url": "https://github.com/johnneerdael/antigravity-gateway/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  }
}
